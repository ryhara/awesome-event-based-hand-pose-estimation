<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Timeline · Awesome Event-based Hands</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Crect width=%2716%27 height=%2716%27 rx=%273%27 fill=%27%23181a19%27/%3E%3Crect x=%273%27 y=%273%27 width=%274.5%27 height=%274.5%27 fill=%27%233ddc78%27/%3E%3Crect x=%278.5%27 y=%273%27 width=%274.5%27 height=%274.5%27 fill=%27%23ff5c5c%27/%3E%3Crect x=%273%27 y=%278.5%27 width=%274.5%27 height=%274.5%27 fill=%27%23ff5c5c%27/%3E%3Crect x=%278.5%27 y=%278.5%27 width=%274.5%27 height=%274.5%27 fill=%27%233ddc78%27/%3E%3C/svg%3E">
<meta name="description" content="How research on hands and event cameras evolved over time: one dot per paper, one lane per task (pose, mesh, tracking, detection, gesture and sign language recognition, datasets, …).">
<script>
  try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
</script>
<style>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#f7f6f3, #151413);
    --surface: light-dark(#ffffff, #1f1d1b);
    --text: light-dark(#1d1b19, #ebe8e4);
    --muted: light-dark(#6d6862, #a29c95);
    --border: light-dark(#e2dfda, #35322e);
    --grid: light-dark(#eeebe6, #2a2825);
    /* Event-camera polarity: ON events are green, OFF events are red. */
    --pos: light-dark(#22a55a, #3ddc78);
    --neg: light-dark(#d9453d, #ff5c5c);
    --accent: light-dark(#1e7d47, #4ed37f);
    --accent-soft: light-dark(#e3f3e9, #16301f);
    --on-accent: light-dark(#ffffff, #08170f);
    --neg-text: light-dark(#b23a37, #ff7b7b);
    --neg-soft: light-dark(#fbe9e7, #3a1e1e);
    --conference: light-dark(#1d4fbf, #8fb0ff);
    --journal: light-dark(#7a3bb8, #cba4f5);
    --workshop: light-dark(#a85a08, #f0b365);
    --preprint: light-dark(#5f5a54, #b5afa8);
    --task-bg: light-dark(#eae6df, #2e2b28);
    --task-fg: light-dark(#3a3632, #d9d4cd);
  }
  :root[data-theme="light"] { color-scheme: light; }
  :root[data-theme="dark"] { color-scheme: dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", "Hiragino Sans", "Noto Sans JP", sans-serif;
    -webkit-text-size-adjust: 100%;
  }
  a { color: var(--accent); }
  button { font: inherit; color: inherit; cursor: pointer; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 16px; }

  header { position: relative; padding: 44px 0 26px; }
  .polarity { flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; width: 0.85em; height: 0.85em; }
  .polarity i { display: block; border-radius: 12%; background: var(--pos); }
  .polarity i:nth-child(2), .polarity i:nth-child(3) { background: var(--neg); }
  h1 {
    display: flex; align-items: center; gap: 0.45em;
    margin: 0 0 8px; padding-right: 48px;
    font-size: clamp(1.5rem, 4.5vw, 2.1rem); line-height: 1.2; letter-spacing: -0.01em; text-wrap: balance;
  }
  h1 .sub { font-weight: 400; color: var(--muted); }
  .theme {
    position: absolute; top: 16px; right: 0;
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; padding: 0;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .theme:hover { color: var(--accent); border-color: var(--accent); }
  .theme svg { width: 18px; height: 18px; }
  .theme .sun, :root[data-theme="dark"] .theme .moon { display: none; }
  :root[data-theme="dark"] .theme .sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .theme .sun { display: block; }
    :root:not([data-theme]) .theme .moon { display: none; }
  }
  .hero-rule { height: 2px; background: linear-gradient(to right, var(--pos) 0 50%, var(--neg) 50% 100%); opacity: 0.85; }
  .lead { margin: 0; color: var(--muted); max-width: 62ch; }
  .lead a { white-space: nowrap; }
  .nav { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 12px 0 0; padding: 0; list-style: none; font-size: 0.92rem; }

  button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Filters: one row, same chips as the list page. */
  .filters {
    margin-top: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 16px;
  }
  .facet { display: grid; grid-template-columns: 64px 1fr; gap: 4px 10px; align-items: baseline; }
  .facet-name { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 3px 10px;
    font-size: 0.88rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .chip .n { margin-left: 5px; font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .chip:hover { border-color: var(--accent); }
  .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .chip[aria-pressed="true"] .n { color: inherit; opacity: 0.8; }
  .chip.empty:not([aria-pressed="true"]) { opacity: 0.4; }
  .status { margin: 18px 2px 0; color: var(--muted); font-size: 0.92rem; font-variant-numeric: tabular-nums; }

  /* The chart: a CSS grid. First column = lane labels (sticky), then one column per year.
     Row 1 = year axis, row 2 = papers per year (bars), then one lane per task (one dot per paper). */
  .chart {
    margin-top: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(148px, max-content) repeat(var(--cols), minmax(38px, 1fr));
    /* Fill the card when it fits, otherwise grow to the columns' minimum and scroll inside .chart. */
    width: 100%;
    width: fit-content;
    min-width: 100%;
  }
  .grid > * { border-bottom: 1px solid var(--grid); }
  .grid > .last { border-bottom: 0; }
  .label {
    position: sticky; left: 0; z-index: 1;
    display: flex; align-items: center; gap: 8px;
    padding: 8px 12px 8px 16px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    font-size: 0.9rem; font-weight: 600;
    white-space: nowrap;
  }
  .label a { color: inherit; text-decoration: none; }
  .label a:hover { color: var(--accent); text-decoration: underline; }
  .label .n { font-weight: 400; color: var(--muted); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .label.empty { color: var(--muted); font-weight: 500; }
  .axis { padding: 10px 0 6px; text-align: center; font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .axis.corner { position: sticky; left: 0; z-index: 1; background: var(--surface); border-right: 1px solid var(--border); text-align: left; padding-left: 16px; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .axis.on { color: var(--text); font-weight: 600; }
  .axis.none { opacity: 0.55; }
  /* Total bars: a column chart whose bars share the year columns of the lanes below. */
  .bar-cell { display: flex; align-items: flex-end; justify-content: center; height: var(--bar-h); padding: 0 6px; }
  .bar { position: relative; width: min(60%, 22px); background: var(--accent); border-radius: 3px 3px 0 0; }
  .bar .v { position: absolute; top: -1.3em; left: 50%; transform: translateX(-50%); font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  /* Lanes: one dot per paper, wrapped inside the year cell. */
  .cell { display: flex; flex-wrap: wrap; align-content: flex-start; justify-content: center; gap: 3px; padding: 7px 4px; min-height: 32px; }
  .cell.none { background: repeating-linear-gradient(135deg, transparent 0 6px, var(--grid) 6px 7px); background-clip: padding-box; opacity: 0.6; }
  .dot {
    width: 14px; height: 14px; padding: 0;
    background: var(--accent);
    border: 2px solid var(--surface);
    border-radius: 50%;
    box-shadow: 0 0 0 1px transparent;
  }
  .dot:hover, .dot:focus-visible, .dot.active { transform: scale(1.25); }
  .dot.linked { box-shadow: 0 0 0 2px var(--accent); }
  .dot.active { background: var(--neg); box-shadow: 0 0 0 2px var(--neg); }
  .dot.dim { opacity: 0.35; }
  .dot { transition: transform 0.12s, opacity 0.12s; }
  @media (prefers-reduced-motion: reduce) { .dot { transition: none; } }
  .hint { margin: 10px 2px 0; color: var(--muted); font-size: 0.85rem; }

  /* Tooltip: fixed near the hovered dot. */
  .tip {
    position: fixed; z-index: 10;
    max-width: min(360px, calc(100vw - 24px));
    padding: 10px 12px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.16);
    font-size: 0.86rem; line-height: 1.4;
  }
  .tip[hidden] { display: none; }
  .tip .meta { display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: 0.78rem; }
  .tip .venue { font-weight: 700; }
  .tip .venue.conference { color: var(--conference); }
  .tip .venue.journal { color: var(--journal); }
  .tip .venue.workshop { color: var(--workshop); }
  .tip .venue.preprint { color: var(--preprint); }
  .tip .kind { color: var(--muted); }
  .tip .task { padding: 1px 8px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--task-fg); background: var(--task-bg); border-radius: 999px; }
  .tip h3 { margin: 4px 0 2px; font-size: 0.95rem; line-height: 1.3; }
  .tip .authors { margin: 0; color: var(--muted); }
  .tip .links { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 6px; }
  .tip .links a { font-weight: 600; text-decoration: none; }
  .tip .links a::after { content: "↗"; font-size: 0.75em; opacity: 0.75; margin-left: 2px; }
  .tip .links a:hover { text-decoration: underline; }

  /* Table view: the same numbers as text. */
  details { margin-top: 18px; }
  summary { cursor: pointer; color: var(--muted); font-size: 0.92rem; }
  .tbl { overflow-x: auto; margin-top: 8px; }
  table { border-collapse: collapse; font-size: 0.86rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  th, td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; }
  th:first-child, td:first-child { text-align: left; }
  thead th { color: var(--muted); font-weight: 600; }
  td.zero { color: var(--muted); opacity: 0.5; }
  tfoot td { font-weight: 600; }

  footer { margin: 40px 0 32px; color: var(--muted); font-size: 0.88rem; }
  footer p { margin: 0 0 10px; }
  .disclaimer { padding: 10px 14px; color: var(--text); background: var(--neg-soft); border-left: 3px solid var(--neg); border-radius: 6px; }
  .disclaimer strong { color: var(--neg-text); }

  @media (max-width: 560px) {
    header { padding-top: 28px; }
    .facet { grid-template-columns: 1fr; }
    /* The label column must never be narrower than its longest name: the grid cannot shrink below
       its columns' minimum, so a fixed minimum would let long names spill into the year cells. */
    .grid { grid-template-columns: max-content repeat(var(--cols), minmax(40px, 1fr)); }
    .label { padding-left: 12px; font-size: 0.82rem; }
    .axis { font-size: 0.74rem; }
  }
</style>
</head>
<body>
<div class="hero">
  <div class="wrap">
    <header>
      <button id="theme" class="theme" type="button" aria-label="Toggle light / dark theme" title="Toggle light / dark theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <h1><span class="polarity" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>Timeline <span class="sub">· Awesome Event-based Hands</span></span></h1>
      <p class="lead">How the field evolved, one dot per paper and one lane per task. Hover or tap a dot for the paper; a paper that covers several tasks appears in each of its lanes.</p>
      <ul class="nav">
        <li><a href="./">← Paper list</a></li>
        <li><a href="__REPO_URL__">View on GitHub</a></li>
      </ul>
    </header>
  </div>
  <div class="hero-rule"></div>
</div>
<div class="wrap">

  <section class="filters" aria-label="Filters">
    <div id="facets"></div>
  </section>

  <p id="status" class="status" role="status" aria-live="polite"></p>
  <div class="chart"><div id="grid" class="grid" role="img" aria-label="Papers per task and year"></div></div>
  <p class="hint">Click a task name to open the filtered paper list. Hatched cells are years with no paper on that task.</p>
  <noscript><p class="status">This page needs JavaScript. The full list is also available in the <a href="__REPO_URL__#papers">README</a>.</p></noscript>

  <details id="table">
    <summary>Table view (papers per task and year)</summary>
    <div class="tbl"></div>
  </details>

  <footer>
    <p class="disclaimer"><strong>Disclaimer.</strong> Entries are maintained by hand and may contain errors. Before citing, always verify the details against the official source (DOI page, proceedings, or arXiv).</p>
    <p>Missing or wrong entry? Edit <a href="__REPO_URL__/blob/main/data/papers.yaml"><code>data/papers.yaml</code></a> and open a pull request.</p>
  </footer>
</div>

<div id="tip" class="tip" role="tooltip" hidden></div>

<script>
const PAPERS = __PAPERS__;
const LINK_LABELS = __LINK_LABELS__;
const TASKS = __TASKS__;
const TYPE_LABELS = { conference: "Conference", journal: "Journal", workshop: "Workshop", preprint: "Preprint" };
const TYPES = Object.keys(TYPE_LABELS);

PAPERS.forEach((p, i) => { p.id = i; });
const YEARS = [];
{
  const ys = PAPERS.map((p) => p.year);
  for (let y = Math.min(...ys); y <= Math.max(...ys); y++) YEARS.push(y);
}

const state = { type: new Set() };
const $ = (id) => document.getElementById(id);
function el(tag, props = {}, children = []) {
  const node = Object.assign(document.createElement(tag), props);
  node.append(...children);
  return node;
}
const shown = () => PAPERS.filter((p) => !state.type.size || state.type.has(p.type));
const listUrl = (task) => {
  const params = new URLSearchParams();
  params.set("task", task);
  if (state.type.size) params.set("type", [...state.type].join("|"));
  return "./#" + params.toString();
};

function renderFacets() {
  const count = {};
  PAPERS.forEach((p) => (count[p.type] = (count[p.type] || 0) + 1));
  const chips = TYPES.filter((t) => count[t]).map((t) => {
    const pressed = state.type.has(t);
    const chip = el("button", { type: "button", className: "chip" }, [TYPE_LABELS[t], el("span", { className: "n", textContent: count[t] })]);
    chip.setAttribute("aria-pressed", pressed);
    chip.addEventListener("click", () => { pressed ? state.type.delete(t) : state.type.add(t); update(); });
    return chip;
  });
  $("facets").replaceChildren(el("div", { className: "facet" }, [
    el("div", { className: "facet-name", textContent: "Type" }),
    el("div", { className: "chips" }, chips),
  ]));
}

function renderGrid() {
  const papers = shown();
  const grid = $("grid");
  grid.style.setProperty("--cols", YEARS.length);
  grid.replaceChildren();

  const perYear = Object.fromEntries(YEARS.map((y) => [y, papers.filter((p) => p.year === y).length]));
  const peak = Math.max(1, ...Object.values(perYear));
  const lastYear = YEARS[YEARS.length - 1];

  // Row 1: year axis.
  grid.append(el("div", { className: "axis corner", textContent: "Task \\ Year" }));
  for (const y of YEARS) grid.append(el("div", { className: "axis" + (perYear[y] ? " on" : " none"), textContent: String(y) }));

  // Row 2: papers per year.
  const BAR_H = 56;
  grid.append(el("div", { className: "label" }, ["All papers", el("span", { className: "n", textContent: papers.length })]));
  for (const y of YEARS) {
    const cell = el("div", { className: "bar-cell", title: `${y}: ${perYear[y]} paper${perYear[y] === 1 ? "" : "s"}` });
    cell.style.setProperty("--bar-h", BAR_H + 10 + "px");
    if (perYear[y]) {
      const bar = el("div", { className: "bar" });
      bar.style.height = Math.max(4, Math.round((perYear[y] / peak) * BAR_H)) + "px";
      // Direct labels only where they help: the peak year and the latest year.
      if (perYear[y] === peak || y === lastYear) bar.append(el("span", { className: "v", textContent: perYear[y] }));
      cell.append(bar);
    }
    grid.append(cell);
  }

  // One lane per task.
  TASKS.forEach((task, ti) => {
    const last = ti === TASKS.length - 1 ? " last" : "";
    const inLane = papers.filter((p) => p.task.includes(task));
    const label = el("div", { className: "label" + (inLane.length ? "" : " empty") + last }, [
      el("a", { href: listUrl(task), textContent: task, title: `Open the paper list filtered by task: ${task}` }),
      el("span", { className: "n", textContent: inLane.length }),
    ]);
    grid.append(label);
    for (const y of YEARS) {
      const here = inLane.filter((p) => p.year === y);
      const cell = el("div", { className: "cell" + (here.length ? "" : " none") + last });
      for (const p of here) {
        const dot = el("button", { type: "button", className: "dot", title: p.title });
        dot.dataset.id = p.id;
        dot.setAttribute("aria-label", `${p.title} (${p.venue} ${p.year})`);
        dot.addEventListener("pointerenter", () => showTip(p, dot, false));
        dot.addEventListener("focus", () => showTip(p, dot, false));
        dot.addEventListener("pointerleave", () => { if (!pinned) hideTip(); });
        dot.addEventListener("blur", () => { if (!pinned) hideTip(); });
        dot.addEventListener("click", (e) => { e.stopPropagation(); pinned && current === p ? unpin() : showTip(p, dot, true); });
        cell.append(dot);
      }
      grid.append(cell);
    }
  });

  $("status").textContent = papers.length === PAPERS.length
    ? `${PAPERS.length} papers, ${YEARS[0]}–${lastYear}`
    : `${papers.length} of ${PAPERS.length} papers, ${YEARS[0]}–${lastYear}`;
}

function renderTable() {
  const papers = shown();
  const head = el("tr", {}, [el("th", { textContent: "Task" }), ...YEARS.map((y) => el("th", { textContent: String(y) })), el("th", { textContent: "Total" })]);
  const rows = TASKS.map((task) => {
    const inLane = papers.filter((p) => p.task.includes(task));
    const cells = YEARS.map((y) => {
      const n = inLane.filter((p) => p.year === y).length;
      return el("td", { className: n ? "" : "zero", textContent: n });
    });
    return el("tr", {}, [el("td", { textContent: task }), ...cells, el("td", { textContent: inLane.length })]);
  });
  const foot = el("tr", {}, [el("td", { textContent: "All papers" }), ...YEARS.map((y) => el("td", { textContent: papers.filter((p) => p.year === y).length })), el("td", { textContent: papers.length })]);
  $("table").querySelector(".tbl").replaceChildren(el("table", {}, [el("thead", {}, [head]), el("tbody", {}, rows), el("tfoot", {}, [foot])]));
}

// Tooltip + cross-highlight of the same paper in its other lanes.
const tip = $("tip");
let current = null, pinned = false;
function showTip(p, dot, pin) {
  current = p;
  pinned = pin;
  document.querySelectorAll(".dot").forEach((d) => {
    const same = Number(d.dataset.id) === p.id;
    d.classList.toggle("linked", same && d !== dot);
    d.classList.toggle("active", d === dot);
  });
  const links = Object.keys(LINK_LABELS).filter((k) => p.links[k]).map((k) =>
    el("a", { href: p.links[k], textContent: LINK_LABELS[k], target: "_blank", rel: "noopener" }));
  tip.replaceChildren(
    el("div", { className: "meta" }, [
      el("span", { className: "venue " + p.type, textContent: `${p.venue} ${p.year}` }),
      el("span", { className: "kind", textContent: TYPE_LABELS[p.type] }),
      ...p.task.map((t) => el("span", { className: "task", textContent: t })),
    ]),
    el("h3", { textContent: p.title }),
    el("p", { className: "authors", textContent: p.authors.join(", ") }),
  );
  if (links.length) tip.append(el("div", { className: "links" }, links));
  tip.hidden = false;
  const r = dot.getBoundingClientRect();
  const w = tip.offsetWidth, h = tip.offsetHeight;
  let x = r.left + r.width / 2 - w / 2, y = r.bottom + 10;
  x = Math.max(12, Math.min(x, innerWidth - w - 12));
  if (y + h > innerHeight - 12) y = r.top - h - 10;
  tip.style.left = x + "px";
  tip.style.top = Math.max(12, y) + "px";
}
function hideTip() {
  tip.hidden = true;
  current = null;
  document.querySelectorAll(".dot.linked, .dot.active").forEach((d) => d.classList.remove("linked", "active"));
}
function unpin() { pinned = false; hideTip(); }
document.addEventListener("click", (e) => { if (pinned && !tip.contains(e.target)) unpin(); });
document.addEventListener("keydown", (e) => { if (e.key === "Escape") unpin(); });
addEventListener("scroll", () => { if (!pinned) hideTip(); }, { passive: true });
document.querySelector(".chart").addEventListener("scroll", () => hideTip(), { passive: true });

// The type filter is mirrored in the URL hash so a view can be shared.
function writeHash() {
  const params = new URLSearchParams();
  if (state.type.size) params.set("type", [...state.type].join("|"));
  const hash = params.toString();
  history.replaceState(null, "", hash ? "#" + hash : location.pathname + location.search);
}
function readHash() {
  const params = new URLSearchParams(location.hash.slice(1));
  state.type = new Set((params.get("type") || "").split("|").filter((t) => TYPES.includes(t)));
}
function update(fromHash) {
  if (!fromHash) writeHash();
  unpin();
  renderFacets();
  renderGrid();
  renderTable();
}
window.addEventListener("hashchange", () => { readHash(); update(true); });
readHash();
update(true);

// Theme toggle: flips relative to whatever is currently shown; the choice is remembered per browser.
const systemDark = matchMedia("(prefers-color-scheme: dark)");
const isDark = () => document.documentElement.dataset.theme === "dark"
  || (!document.documentElement.dataset.theme && systemDark.matches);
$("theme").addEventListener("click", () => {
  const next = isDark() ? "light" : "dark";
  document.documentElement.dataset.theme = next;
  try { localStorage.setItem("theme", next); } catch {}
});
</script>
</body>
</html>
